# Nonsecret optional server tuning. No API key/cloud account is needed.
# This file is a reference, NOT automatically loaded by run_local.py or serve.py.
# Set variables in your shell before starting the app (see LOCAL_SETUP.md).
# Keep the defaults unless you understand the resource implications.
BOND_ATLAS_WORKERS=2
BOND_ATLAS_QUEUE=8
BOND_ATLAS_TIMEOUT=45
BOND_ATLAS_JOB_TTL=600
BOND_ATLAS_MEMORY_MB=2048
BOND_ATLAS_MAX_BODY=1048576
# Host/port are CLI arguments, not .env settings. The launcher always binds loopback.
